<https://w3id.org/bigcontext-schema.owl.ttl> dcterms:title "BigContext Schema (draft)" ;
	pav:version "0.9.1-draft" ;
	a owl:Ontology ;
	rdfs:label "bigcontext_schema" ;
	skos:definition "A small, closed set of building blocks for expressing business context taken from natural language: simple rules, long procedures, company structure, data and mappings. Tier 1 is the element types, tier 2 the statement types (predicates) whose roles come from one shared dictionary of slots, tier 3 the qualifiers every statement can carry. Kinds of a particular product (such as BigContext's 52) live in that product's profile, not here. Shared groups of fields any statement can carry (decision, assignment, snapshot, data profile) cover kinds of context that recur across many statement types. A computable core (key pairs, filters, aggregations, metric types, time grains) lets metric and join definitions move to and from semantic-layer formats." .
bcs:AccessEnum\#admin a owl:Class ;
	rdfs:label "admin" ;
	rdfs:subClassOf bcs:AccessEnum .
bcs:AccessEnum\#granted a owl:Class ;
	rdfs:label "granted" ;
	rdfs:subClassOf bcs:AccessEnum ;
	skos:definition "Has access; the text does not say what kind." .
bcs:AccessEnum\#masked a owl:Class ;
	rdfs:label "masked" ;
	rdfs:subClassOf bcs:AccessEnum ;
	skos:definition "Can see the data with sensitive values masked." .
bcs:AccessEnum\#none a owl:Class ;
	rdfs:label "none" ;
	rdfs:subClassOf bcs:AccessEnum .
bcs:AccessEnum\#read a owl:Class ;
	rdfs:label "read" ;
	rdfs:subClassOf bcs:AccessEnum .
bcs:AccessEnum\#use a owl:Class ;
	rdfs:label "use" ;
	rdfs:subClassOf bcs:AccessEnum ;
	skos:definition "Can call or operate a tool, system or service." .
bcs:AccessEnum a owl:Class ;
	rdfs:label "AccessEnum" ;
	owl:unionOf _:c14n544 ;
	skos:inScheme <https://w3id.org/bigcontext-schema> ;
	linkml:permissible_values bcs:AccessEnum\#admin , bcs:AccessEnum\#granted , bcs:AccessEnum\#masked , bcs:AccessEnum\#none , bcs:AccessEnum\#read , bcs:AccessEnum\#use .
