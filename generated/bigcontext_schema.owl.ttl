	skos:definition "The SQL dialect of the expression (ANSI_SQL, Snowflake, BigQuery)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:direct a owl:DatatypeProperty ;
	rdfs:label "direct" ;
	rdfs:range xsd:boolean ;
	skos:definition "True when the source says the reporting line is direct." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:direction a owl:ObjectProperty ;
	rdfs:label "direction" ;
	rdfs:range bcs:DirectionEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:disputed_by a owl:ObjectProperty ;
	rdfs:label "disputed_by" ;
	rdfs:range bcs:Element ;
	skos:definition "Who disagreed or objected." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:distinct a owl:DatatypeProperty ;
	rdfs:label "distinct" ;
	skos:definition "True when the value counts different individuals (\"two different managers\")." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:divided_by a owl:ObjectProperty ;
	rdfs:label "divided_by" ;
	rdfs:range bcs:Element ;
	skos:definition "The field or dimension that divides a group into its members (returns divided by reason into damaged and unwanted)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:due_by a owl:DatatypeProperty ;
	rdfs:label "due_by" ;
	skos:definition "The deadline it must be done by, in the text's own words ('2026-11-30', '30 November', 'the end of each fiscal quarter', 'two weeks before launch'); a duration goes in within." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:each a owl:DatatypeProperty ;
	rdfs:label "each" ;
	rdfs:range xsd:boolean ;
	skos:definition "True when the statement holds for each member of a class it names, not for the class itself ('nine offices, each headed by an Assistant Administrator')." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:end a owl:DatatypeProperty ;
	rdfs:label "end" ;
	skos:definition "The last day, as an ISO date: 2026-03 for 'March 2026' (a year or month means its last day)." ;
	skos:exactMatch dcat:endDate ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:endorsed_by a owl:ObjectProperty ;
	rdfs:label "endorsed_by" ;
	rdfs:range bcs:Element ;
	skos:definition "Who agreed or supported it (+1, 'fine for now')." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:entity a owl:ObjectProperty ;
	rdfs:label "entity" ;
	rdfs:range bcs:Element ;
	skos:definition "The kind of thing a conversion metric follows from its first event to its second (the cart, the user)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:especially_when a owl:ObjectProperty ;
	rdfs:label "especially_when" ;
	rdfs:range bcs:Condition ;
	skos:definition "Conditions under which it holds most often or most strongly ('especially if', 'particularly when'); unlike when, it also holds without them." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:even_if a owl:ObjectProperty ;
	rdfs:label "even_if" ;
	rdfs:range bcs:Condition ;
	skos:definition "Conditions under which the statement still holds ('even if', 'including when')." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:evidence a owl:ObjectProperty ;
	rdfs:label "evidence" ;
	rdfs:range bcs:Evidence ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:exclusive a owl:DatatypeProperty ;
	rdfs:label "exclusive" ;
	rdfs:range xsd:boolean ;
	skos:definition "True when the source says only these (only analysts, the only warehouse that ships abroad)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:expected_cardinality a owl:ObjectProperty ;
	rdfs:label "expected_cardinality" ;
	rdfs:range bcs:CardinalityEnum ;
	skos:definition "The cardinality a join should have, as the text states it (one of the pair values); cardinality is what the data has." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:expression a owl:DatatypeProperty ;
	rdfs:label "expression" ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:extensions a owl:ObjectProperty ;
	rdfs:label "extensions" ;
	rdfs:range bcs:Any ;
	skos:definition "Fields of your own, under keys that start with a prefix you own (acme:priority). Readers keep them and may ignore them; they never change what the rest of the document means." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:external a owl:DatatypeProperty ;
	rdfs:label "external" ;
	skos:definition "Ids this file refers to that another section of the same source declares." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:field a owl:ObjectProperty ;
	rdfs:label "field" ;
	skos:definition "The column the filter tests." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:filters a owl:ObjectProperty ;
	rdfs:label "filters" ;
	rdfs:range bcs:Condition ;
	skos:definition "Row filters: on a metric, applied before aggregating; on access, the rows it is limited to." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:frequency a owl:ObjectProperty ;
	rdfs:label "frequency" ;
	rdfs:range bcs:FrequencyEnum ;
	skos:definition "How often it holds; how many members of a class it holds for is quantifier." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:from_field a owl:ObjectProperty ;
	rdfs:label "from_field" ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:from_state a owl:ObjectProperty ;
	rdfs:label "from_state" ;
	rdfs:range bcs:Concept ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:go_to a owl:DatatypeProperty ;
	rdfs:label "go_to" ;
	skos:definition "The id of the step to go to." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:goal a owl:DatatypeProperty ;
	rdfs:label "goal" ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:grain_to_date a owl:ObjectProperty ;
	rdfs:label "grain_to_date" ;
	rdfs:range bcs:TimeGrainEnum ;
	skos:definition "A cumulative metric taken from the start of this grain (year for year to date), in the metric's calendar." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:held_by a owl:ObjectProperty ;
	rdfs:label "held_by" ;
	rdfs:range bcs:Element ;
	skos:definition "Whose preference, view or wish this is." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:id a owl:DatatypeProperty ;
	rdfs:label "id" ;
	rdfs:range _:c14n693 ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:importance a owl:ObjectProperty ;
	rdfs:label "importance" ;
	rdfs:range bcs:ImportanceEnum ;
	skos:definition "How much it matters, when the source says (critical, very important, minor)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:informed a owl:ObjectProperty ;
	rdfs:label "informed" ;
	rdfs:range bcs:Element ;
	skos:definition "Who was told." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:inputs a owl:ObjectProperty ;
	rdfs:label "inputs" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:items a owl:ObjectProperty ;
	rdfs:label "items" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:join_type a owl:ObjectProperty ;
	rdfs:label "join_type" ;
	rdfs:range bcs:JoinTypeEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:justification a owl:DatatypeProperty ;
	rdfs:label "justification" ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:key_pairs a owl:ObjectProperty ;
	rdfs:label "key_pairs" ;
	rdfs:range bcs:KeyPair ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:keys a owl:DatatypeProperty ;
	rdfs:label "keys" ;
	skos:definition "Key pairs such as \"orders.customer_id = customers.customer_id\"." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:label a owl:DatatypeProperty ;
	rdfs:label "label" ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:line a owl:ObjectProperty ;
	rdfs:label "line" ;
	rdfs:range bcs:LineEnum ;
	skos:definition "Solid or dotted reporting or membership line." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:linked_sources a owl:ObjectProperty ;
	rdfs:label "linked_sources" ;
	rdfs:range bcs:LinkedSource ;
	skos:definition "Other sources this document refers to as prefix:id, for links between sources." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:location a owl:DatatypeProperty ;
	rdfs:label "location" ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:match a owl:ObjectProperty ;
	rdfs:label "match" ;
	rdfs:range bcs:MatchEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:members a owl:ObjectProperty ;
	rdfs:label "members" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:metric_type a owl:ObjectProperty ;
	rdfs:label "metric_type" ;
	rdfs:range bcs:MetricTypeEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:modality a owl:ObjectProperty ;
	rdfs:label "modality" ;
	rdfs:range bcs:ModalityEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:mode a owl:ObjectProperty ;
	rdfs:label "mode" ;
	rdfs:range bcs:ProcedureModeEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:modified a owl:DatatypeProperty ;
	rdfs:label "modified" ;
	rdfs:range _:c14n182 ;
	skos:definition "When the source was last changed (\"Last updated\"), as an ISO date." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:named a owl:ObjectProperty ;
	rdfs:label "named" ;
	skos:definition "The period as the text names it, a concept of type period ('Q3 2026', 'the holiday season')." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:negated a owl:DatatypeProperty ;
	rdfs:label "negated" ;
	rdfs:range xsd:boolean ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:next a owl:DatatypeProperty ;
	rdfs:label "next" ;
	skos:definition "Ids of the steps that follow." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:non_additive a owl:ObjectProperty ;
	rdfs:label "non_additive" ;
	rdfs:range bcs:NonAdditive ;
	skos:definition "The dimensions a stored measure must not be summed across." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:normalize a owl:ObjectProperty ;
	rdfs:label "normalize" ;
	skos:definition "What is done to both columns before they are compared, always in this order whichever are given (trim, then ignore case, then cast)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:note a owl:DatatypeProperty ;
	rdfs:label "note" ;
	skos:definition "A remark from whoever expressed the context; never part of its meaning." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:numerator a owl:ObjectProperty ;
	rdfs:label "numerator" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:object a owl:ObjectProperty ;
	rdfs:label "object" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:objects a owl:ObjectProperty ;
	rdfs:label "objects" ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:options_in_order a owl:ObjectProperty ;
	rdfs:label "options_in_order" ;
	skos:definition "Alternatives in order of preference, first preferred." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:or_more_senior a owl:DatatypeProperty ;
	rdfs:label "or_more_senior" ;
	rdfs:range xsd:boolean ;
	skos:definition "True when the posts or roles the statement names also cover anyone more senior ('a VP or higher')." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:order a owl:DatatypeProperty ;
	rdfs:label "order" ;
	rdfs:range xsd:integer ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:outcome a owl:DatatypeProperty ;
	rdfs:label "outcome" ;
	skos:definition "Where the procedure ends up if it does not go to a step (stop, escalate, done)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:outputs a owl:ObjectProperty ;
	rdfs:label "outputs" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:overrides a owl:ObjectProperty ;
	rdfs:label "overrides" ;
	rdfs:range bcs:Element ;
	skos:definition "Statements this one takes precedence over." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:party_responsibility a owl:ObjectProperty ;
	rdfs:label "party_responsibility" ;
	skos:definition "The responsibility whoever is acting must hold (\"only the metric's owner may change it\": owns), for what the rule acts on, or, with field, for the element that column names on the row (the metric a change is about). Only in a Rule's when or unless; never with values or compare_to." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:per a owl:ObjectProperty ;
	rdfs:label "per" ;
	rdfs:range bcs:Element ;
	skos:definition "For each of these: a limit for each (3 refunds per customer per calendar month), or a value kept for each (the last balance for each account)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:performer a owl:ObjectProperty ;
	rdfs:label "performer" ;
	rdfs:range bcs:Element ;
	skos:definition "Who does it; several when they do it together." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:period a owl:ObjectProperty ;
	rdfs:label "period" ;
	rdfs:range bcs:Period ;
	skos:definition "The stretch of data or business time the statement is about (the days data is missing, the quarter a target is for); it never ends the statement, which is valid_from and valid_to." ;
	skos:exactMatch dcterms:temporal ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:physical_name a owl:DatatypeProperty ;
	rdfs:label "physical_name" ;
	skos:definition "The object's name in its system (tpcds.public.store_sales; a tool's name in its MCP server)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:predicate a owl:DatatypeProperty ;
	rdfs:label "predicate" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:prefix a owl:DatatypeProperty ;
	rdfs:label "prefix" ;
	skos:definition "The short name used before the colon (metrics in metrics:c.active_customer)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:primary a owl:DatatypeProperty ;
	rdfs:label "primary" ;
	rdfs:range xsd:boolean ;
	skos:definition "True when the source calls this the primary, core or canonical representation; false for an alternate key." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:procedures a owl:ObjectProperty ;
	rdfs:label "procedures" ;
	rdfs:range bcs:Procedure ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:produces a owl:ObjectProperty ;
	rdfs:label "produces" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:progress a owl:ObjectProperty ;
	rdfs:label "progress" ;
	rdfs:range bcs:ProgressEnum ;
	skos:definition "How far an action item or piece of work has got." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:property_value a owl:ObjectProperty ;
	rdfs:label "property_value" ;
	rdfs:range bcs:Value ;
	skos:definition "The value the element has for the attribute." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:proposed_by a owl:ObjectProperty ;
	rdfs:label "proposed_by" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:proposed_predicate a owl:DatatypeProperty ;
	rdfs:label "proposed_predicate" ;
	skos:definition "The statement type you would have needed." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:quantifier a owl:ObjectProperty ;
	rdfs:label "quantifier" ;
	rdfs:range bcs:QuantifierEnum ;
	skos:definition "How many members of a class it names the statement holds for, when not every one ('some customers', 'most shoppers'); every one is each. Like each, it makes the statement about the members, not the class." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:quote a owl:DatatypeProperty ;
	rdfs:label "quote" ;
	skos:definition "Copied exactly from the source text; never blank." ;
	skos:exactMatch oa:exact ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:ratified_by a owl:ObjectProperty ;
	rdfs:label "ratified_by" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:ratified_in a owl:ObjectProperty ;
	rdfs:label "ratified_in" ;
	rdfs:range bcs:Element ;
	skos:definition "Where it was ratified (a meeting, a council, a document)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:ratified_on a owl:DatatypeProperty ;
	rdfs:label "ratified_on" ;
	rdfs:range _:c14n634 ;
	skos:definition "When it was ratified, as an ISO date." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:reason a owl:ObjectProperty ;
	rdfs:label "reason" ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:recorded_on a owl:DatatypeProperty ;
	rdfs:label "recorded_on" ;
	rdfs:range _:c14n109 ;
	skos:definition "When the source says the fact or figure was recorded or restated, as an ISO date." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:recurrence a owl:DatatypeProperty ;
	rdfs:label "recurrence" ;
	skos:definition "How often a duty recurs ('every month', 'each Monday'); a rotation's turnover goes in cadence, how often something is true in frequency." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:reporting_grain a owl:ObjectProperty ;
	rdfs:label "reporting_grain" ;
	rdfs:range bcs:TimeGrainEnum ;
	skos:definition "The time grain a metric is reported at unless asked otherwise ('for each day')." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:responsibility a owl:ObjectProperty ;
	rdfs:label "responsibility" ;
	rdfs:range bcs:ResponsibilityEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:result a owl:ObjectProperty ;
	rdfs:label "result" ;
	skos:definition "The result when the condition holds." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:reviewed a owl:DatatypeProperty ;
	rdfs:label "reviewed" ;
	rdfs:range _:c14n1 ;
	skos:definition "When the source was last reviewed, as an ISO date." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:revised_by a owl:ObjectProperty ;
	rdfs:label "revised_by" ;
	skos:definition "Who made or approved this revision." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:revisions a owl:ObjectProperty ;
	rdfs:label "revisions" ;
	rdfs:range bcs:Revision ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:role a owl:ObjectProperty ;
	rdfs:label "role" ;
	rdfs:range bcs:Concept ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:schema_version a owl:DatatypeProperty ;
	rdfs:label "schema_version" ;
	rdfs:range _:c14n646 ;
	skos:definition "The version of BigContext Schema the document follows, such as 1.0.0." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:scope a owl:ObjectProperty ;
	rdfs:label "scope" ;
	rdfs:range bcs:Element ;
	skos:definition "The elements the statement is limited to." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:sequence_type a owl:ObjectProperty ;
	rdfs:label "sequence_type" ;
	rdfs:range bcs:SequenceTypeEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:share a owl:ObjectProperty ;
	rdfs:label "share" ;
	rdfs:range bcs:Value ;
	skos:definition "The share of time (50%)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:skipped a owl:ObjectProperty ;
	rdfs:label "skipped" ;
	rdfs:range bcs:Skipped ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:so_that a owl:ObjectProperty ;
	rdfs:label "so_that" ;
	rdfs:range bcs:Condition ;
	skos:definition "The purpose the source gives ('in order to', 'so that')." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:source a owl:ObjectProperty ;
	rdfs:label "source" ;
	rdfs:range bcs:Source ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:source_label a owl:DatatypeProperty ;
	rdfs:label "source_label" ;
	skos:definition "The step's own number or letter in the source (3a, 4.)." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:specific_verb a owl:DatatypeProperty ;
	rdfs:label "specific_verb" ;
	skos:definition "The verb as the text uses it, in lower case, when it is more specific than the closed class (page, recommend, deduplicate, invite). It is the organization's vocabulary, not a closed list." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:stable a owl:DatatypeProperty ;
	rdfs:label "stable" ;
	rdfs:range xsd:boolean ;
	skos:definition "False when a key can change (an email, a device id): it still identifies the row on a date, not over time." ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:standard_attribute a owl:ObjectProperty ;
	rdfs:label "standard_attribute" ;
	rdfs:range bcs:StandardAttributeEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:start a owl:DatatypeProperty ;
	rdfs:label "start" ;
	skos:definition "The first day, as an ISO date." ;
	skos:exactMatch dcat:startDate ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:stated_by a owl:ObjectProperty ;
	rdfs:label "stated_by" ;
	rdfs:range bcs:Element ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:statements a owl:ObjectProperty ;
	rdfs:label "statements" ;
	rdfs:range bcs:Statement ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:status a owl:ObjectProperty ;
	rdfs:label "status" ;
	rdfs:range bcs:StatusEnum ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:steps a owl:ObjectProperty ;
	rdfs:label "steps" ;
	rdfs:range bcs:Step ;
	skos:inScheme <https://w3id.org/bigcontext-schema> .
bcs:subject a owl:ObjectProperty ;
	rdfs:label "subject" ;
